# 运行时数据（用户本地内容，不入库）
/runtimes/
/cache/
/servers/
/backups/
/bg/
/logs/
/data/
/update.bat
# 配置和密钥，连同保存时的临时文件和手工备份（secrets.json.tmp、config.json.bak 之类）
/config.json*
/secrets.json*
/tunnels.json*

# 构建产物
*.exe
*.exe~
# README 里让在仓库根目录编的两个测试小工具，Linux 上编出来没有 .exe 后缀
/testsend
/testctl

# Python 工具的缓存（tools/handover-test 的脚本互相导入时会生成）
__pycache__/
*.pyc

# 编辑器
.idea/
.vscode/

# AI 工具留在本机的东西（技能包、工作树、评审草稿）
.claude/
.agents/
.review/
.codex-review/
.mimocode/
.mimocode-project-id

# 宣传图的输出（tools/promo/shoot.js）
/tools/promo/out/

# 介绍页的发布产物（.github/workflows/pages.yml 组装 site/ 和图片）
/_site/
